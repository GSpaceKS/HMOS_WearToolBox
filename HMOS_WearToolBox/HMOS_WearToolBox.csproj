<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0-beta3</Version>
    <ApplicationIcon>Resources\Icon\ICON_256.ico</ApplicationIcon>
	<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\app_names.json" />
    <None Remove="Resources\Fonts\CascadiaCode\CascadiaCode.ttf" />
    <None Remove="Resources\Fonts\CascadiaMono\CascadiaMono.ttf" />
    <None Remove="Resources\Fonts\HarmonyOS_Sans_SC\HarmonyOS_Sans_SC_Black.ttf" />
    <None Remove="Resources\Fonts\HarmonyOS_Sans_SC\HarmonyOS_Sans_SC_Bold.ttf" />
    <None Remove="Resources\Fonts\HarmonyOS_Sans_SC\HarmonyOS_Sans_SC_Medium.ttf" />
    <None Remove="Resources\HDC\hdc.exe" />
    <None Remove="Resources\HDC\libusb_shared.dll" />
    <None Remove="Resources\Sign\sign-tool.zip" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Icon\ICON_256.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app_names.json" />
    <EmbeddedResource Include="Resources\Fonts\CascadiaCode\CascadiaCode.ttf" />
    <EmbeddedResource Include="Resources\Fonts\CascadiaMono\CascadiaMono.ttf" />
    <EmbeddedResource Include="Resources\Fonts\HarmonyOS_Sans_SC\HarmonyOS_Sans_SC_Black.ttf" />
    <EmbeddedResource Include="Resources\Fonts\HarmonyOS_Sans_SC\HarmonyOS_Sans_SC_Bold.ttf" />
    <EmbeddedResource Include="Resources\Fonts\HarmonyOS_Sans_SC\HarmonyOS_Sans_SC_Medium.ttf" />
    <EmbeddedResource Include="Resources\HDC\hdc.exe" Condition="Exists('Resources\HDC\hdc.exe')" />
    <EmbeddedResource Include="Resources\HDC\libusb_shared.dll" Condition="Exists('Resources\HDC\libusb_shared.dll')" />
    <EmbeddedResource Include="Resources\Sign\sign-tool.zip" Condition="Exists('Resources\Sign\sign-tool.zip')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>